# 默认后端 claude-code 用本机 Claude Code 登录的 Max/Pro 订阅，不需要这个文件。
# 只有 KB_BACKEND=api 时才需要：复制为 .env 并填入 API Key（.env 已 gitignore；本文件会被提交，切勿写真实 Key）
# KB_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# 可选：
# KB_CC_MODEL=opus            # claude-code 后端的模型
# KB_MODEL=claude-opus-5-5    # api 后端的模型
# KB_CHAT_EFFORT=medium
# PORT=8787
